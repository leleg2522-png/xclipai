            "text": "{\"status\":\"success\",\"response\":{\"id\":\"496b25b9-9c45-497a-8e3e-9061475466dd\",\"status\":\"COMPLETED\",\"created\":\"2026-10-15T05:21:09.418Z\",\"updated\":\"2026-10-15T05:21:09.418Z\",\"result\":{\"agents\":{\"picsart-flair\":{\"name\":\"Flair\",\"description\":\"Flair is your AI creative director for Shopify. It analyzes your brand, understands your store's visual identity, and handles everything from background removal to lifestyle scene generation. Connect your Shopify store and let Flair manage your entire product photography workflow — from raw shots to published, on-brand visuals.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"movie-maker\":{\"name\":\"Cinema Studio\",\"description\":\"AI cinematographer that turns a text description into a short cinematic video — plans scenes, generates shots, and assembles them into a final movie.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"content-repurposer\":{\"name\":\"Repurpose\",\"description\":\"AI video editor that transforms long-form videos into viral short-form clips for TikTok, Instagram Reels, and YouTube Shorts.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"film-adk\":{\"name\":\"Keyframe (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"debug-agent-adk\":{\"name\":\"Debug Agent (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"billy-adk\":{\"name\":\"Billy (ADK)\",\"description\":\"ADK on Agent Engine (OpenAI).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"repurpose-pro-v2-adk\":{\"name\":\"Repurpose Pro (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"joke-teller-adk\":{\"name\":\"Joke teller (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"landing-studio-adk\":{\"name\":\"Landing Studio (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"ads-manager-adk\":{\"name\":\"Ads Manager (ADK)\",\"description\":\"ADK on Agent Engine (Gemini).\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"thumbnail-maker\":{\"name\":\"Thumbnail Maker\",\"description\":\"YouTube thumbnails and Instagram Reel covers from a finished video: the agent watches the video, turns its promise into hook directions and headlines it actually delivers, renders each design as one picture with the presenter in the scene and the headline in the image, a Reel cover in the brand's own type from a typeset plate, and exports the picks.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"dama\":{\"name\":\"Dama\",\"description\":\"Your game designer. Dama builds your story world with you first, then turns it into a playable 2D game, tests that it can be won, saves it to your Drive ready for itch.io, and keeps it growing with new characters, places and chapters on the schedule you choose.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"draper\":{\"name\":\"Draper\",\"description\":\"Your ad strategist. Draper reads your website, confirms a few quick answers with you, and hands back a short, clear paid ad plan covering who to reach, where to advertise, how much to spend, and what to do first.\",\"free\":true,\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"google-ads-manager\":{\"name\":\"Google Ads Manager\",\"description\":\"Your dedicated Google Ads manager. Pax sets you up, makes the creative (generates images, video, and audio and sizes them to Google's exact specs), prepares paused campaigns, manages approved delivery and budgets, shows how you're doing in clear tables and charts, and coaches you to a stronger ad.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"slava\":{\"name\":\"Slava\",\"description\":\"Your head of performance marketing. Slava runs paid user acquisition the way a data scientist would run it: finds the competitor ad worth beating, builds a region-native video ad from it, screens it in a cheap reach test, promotes winners head to head against your champion, moves budget by rule, and writes a verdict on every ad before it leaves a stage.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"earn-with-picsart-agent\":{\"name\":\"Earn With Picsart Agent\",\"description\":\"AI assistant for Picsart Earn admins and moderators. Investigates creator-support tickets, submissions, payouts and campaigns through the read-only earn-with-picsart admin API.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"movie-producer\":{\"name\":\"Movie Producer\",\"description\":\"AI movie producer for the Picsart Video Editor mobile app that turns a story into a short narrative movie — multiple scenes, recurring characters, a locked visual style — through a staged production pipeline with review gates: development, assets, scenes, edit, finishing. Every charged generation is priced on a plan card first, and every stage is reviewed on a scene card before the next begins. The app plays and exports the finished movie on the device.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"picsart-assistant\":{\"name\":\"Picsart Assistant\",\"description\":\"The general chat of the Picsart mobile app. Ask for anything you want made or edited and it makes it right there, with any Picsart tool or generation model and a recommendation for which one fits. The few jobs that come back better from a specialist — reels from your footage, movies, vertical drama series, personas, decks — are handed over inside the same chat, so you are never sent anywhere. Built for the phone: short replies, one question at a time.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"short-reel-maker\":{\"name\":\"Short Reel Maker\",\"description\":\"AI video editor for the Picsart mobile assistant chat that turns long videos, clips, and photos into ready-to-post vertical shorts for TikTok, Instagram Reels, and YouTube Shorts. Pick your footage and it finds the best moments, cuts them so nobody is ever clipped mid-sentence, keeps the speaker framed, adds punchy on-screen text, and scores it with music. You approve each step before it goes in — in short, phone-friendly messages.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"short-drama-agent\":{\"name\":\"Short Drama Agent\",\"description\":\"Saga produces vertical drama series, sitcom pilots and standalone narrative shorts with consistent characters, an approved production brief, resumable work and evidence-based delivery checks.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"insights-agent\":{\"name\":\"Insights Agent\",\"description\":\"Vera, your Zappi-powered ad research director for creative scoring, audience insight, variant comparison, and performance learning.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"aura\":{\"name\":\"Creative Mastermind\",\"description\":\"One conversation that turns a sentence into images, audio, and video up to ten minutes long — by commanding Picsart's entire roster of specialists so you never have to pick a tool, learn prompt syntax, or stitch a production together yourself.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"reel-maker\":{\"name\":\"Reel Maker\",\"description\":\"Create cinematic reels from ideas or photo references, assemble the user’s actual media into a montage, or edit and extend an existing video.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"work-space\":{\"name\":\"Work Space\",\"description\":\"Your Picsart creative home base — organizes projects, finds files, keeps your Drive tidy. Think Claude Code for your creative work.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"slide-studio\":{\"name\":\"Slide Studio\",\"description\":\"AI presentation designer — transforms rough ideas, notes, or ugly slides into polished, professional presentations.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"localization-agent\":{\"name\":\"Localization Agent\",\"description\":\"Visual localization specialist — regenerates imagery per market, swaps products for regional variants, dubs video voiceovers while preserving speaker identity, and flags cultural signals that don't travel.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"repurpose-pro\":{\"name\":\"Repurpose Pro\",\"description\":\"Long-form-to-short-form specialist. One podcast, keynote, or YouTube link becomes a batch of platform-native clips — complete-thought boundaries, per-clip rationale, CTR-optimized thumbnails, optional dubbing, and a 2-week schedule.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"video-director\":{\"name\":\"Video Director\",\"description\":\"AI video director that handles the full spectrum: generate cinematic video from text, curate and cut your footage into beat-synced edits, mix both, recut long-form into short-form, reframe, enhance, and swap audio.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"research-agent\":{\"name\":\"User Research Agent\",\"description\":\"Helps PMs, designers, and engineers evaluate prototypes and live products with structured UX reviews — heuristic-style, severity-rated, under 500 words.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"brand-builder\":{\"name\":\"Brand Builder\",\"description\":\"Brand identity designer that produces a complete identity system: logo, palette, typography, brand voice, brand book, and starter templates — all in a single session.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"interior-studio\":{\"name\":\"Interior Studio\",\"description\":\"Sage, Picsart's interior designer: reads a real room photo or floor plan, names what is holding it back, offers four genuinely different directions, renders the chosen one on the user's own photo with the architecture kept, and turns it into a verified shopping list, walkthrough and client summary.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"data-storyteller\":{\"name\":\"Data Storyteller\",\"description\":\"Data-to-visual specialist — turns raw spreadsheets into beautiful, shareable infographics with the top three insights and a \\\"so what\\\" recommendation.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"listing-agent\":{\"name\":\"Listing Agent\",\"description\":\"Real estate listing producer — turns 10–30 raw property photos into a complete MLS-ready marketing package: staged interiors, twilight exteriors, grass-greened yards, a 60-second walkthrough video, listing PDF, and 9:16 social reels.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"ai-influencer\":{\"name\":\"AI Influencer\",\"description\":\"End-to-end AI influencer agent — builds and embodies your AI personas, researches trends, creates ready-to-post images and videos with captions and hashtags, and publishes straight to your Instagram, TikTok, and YouTube accounts.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"bg-swap\":{\"name\":\"Swap\",\"description\":\"AI assistant that replaces image backgrounds with AI-generated scenes — isolates the subject, places it into the new setting, and matches lighting, perspective, and shadows.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"smart-resize\":{\"name\":\"Smart Resize\",\"description\":\"AI assistant that intelligently adapts images and videos for any platform or dimension — analyzes scenes, identifies subjects, and makes compositional decisions so every output looks intentionally designed for its destination.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0},\"style-remix\":{\"name\":\"Style Remix\",\"description\":\"Picsart Art Director and Photo Editor for polished still images — precise edits, product photography, try-on, color, backgrounds, restoration, resizing, editable compositions, and coherent batches.\",\"status\":\"not_onboarded\",\"unreadThreadCount\":0}}},\"usage\":{\"credits\":0,\"details\":[]}}}"
          },
